# ─────────────────────────────────────────────────────────────
#  Copie este archivo como .env.local y complete los valores.
#  Sin estas variables el sitio funciona con contenido de DEMOSTRACIÓN
#  y el panel de administración se muestra en modo de solo lectura.
# ─────────────────────────────────────────────────────────────

# URL pública definitiva del sitio (para sitemap, Open Graph y datos estructurados)
NEXT_PUBLIC_SITE_URL=https://www.ejemplo-del-artista.com

# Permitir que los buscadores indexen el sitio. Déjelo en "false" mientras haya contenido de demostración.
SITE_INDEXING=false

# ── Supabase (base de datos, almacenamiento de fotografías y acceso al panel) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en el servidor. Se usa para guardar los mensajes del formulario de contacto.
SUPABASE_SERVICE_ROLE_KEY=

# ── Envío de correos del formulario (opcional, https://resend.com) ──
RESEND_API_KEY=
# Dirección que recibe las consultas
CONTACT_TO_EMAIL=
# Remitente verificado en Resend, p. ej. "Galería <consultas@su-dominio.com>"
CONTACT_FROM_EMAIL=

# ── Canales de contacto visibles en el sitio (déjelos vacíos si no aplican) ──
NEXT_PUBLIC_CONTACT_EMAIL=
# Número en formato internacional, solo dígitos. Ej.: 5213312345678
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
